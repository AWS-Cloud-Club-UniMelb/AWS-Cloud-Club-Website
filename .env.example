# Google Apps Script web app URL (deployed from the "AWS Cloud Club event
# registrations" workbook). The same /exec endpoint serves both:
#   - GET  → returns published upcoming events from the Events sheet
#   - POST → appends a registration row to a per-event tab
NEXT_PUBLIC_REGISTRATION_ENDPOINT=https://script.google.com/macros/s/REPLACE_ME/exec

# Shared secret checked server-side by the Apps Script doPost handler.
# Not a real secret (ships to the browser) — just blocks casual abuse.
NEXT_PUBLIC_REGISTRATION_SECRET=REPLACE_ME
